<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- e-mail footers: "Powered by Odoo" → brand (or nothing) -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" name="Identity: mail layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]/.." position="replace">
            <t t-set="identity" t-value="company.identity_brand()"/>
            <div t-if="show_footer and (identity['powered_by'] or show_unfollow)" style="color: #555555; font-size:11px;">
                <t t-if="identity['powered_by']">
                    Powered by <a t-if="identity['url']" target="_blank" t-att-href="identity['url']"
                                  t-att-style="'color: ' + (company.email_secondary_color or '#555555') + ';'"><t t-out="identity['name']"/></a>
                    <span t-else="" t-out="identity['name']"/>
                </t>
                <span t-if="show_unfollow" id="mail_unfollow">
                    <t t-if="identity['powered_by']">|</t> <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" name="Identity: light mail layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]/.." position="replace">
            <t t-set="identity" t-value="company.identity_brand()"/>
            <td align="center" style="min-width: 590px;">
                <t t-if="identity['powered_by']">
                    Powered by <a t-if="identity['url']" target="_blank" t-att-href="identity['url']"
                                  t-att-style="'color: ' + (company.email_secondary_color or '#555555') + ';'"><t t-out="identity['name']"/></a>
                    <span t-else="" t-out="identity['name']"/>
                </t>
                <span t-if="show_unfollow" id="mail_unfollow">
                    <t t-if="identity['powered_by']">|</t> <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </td>
        </xpath>
    </template>

</odoo>
