<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rvt_project_trade_view_list" model="ir.ui.view">
        <field name="name">rvt.project.trade.list</field>
        <field name="model">rvt.project.trade</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="is_undecided_late">
                <field name="project_id" column_invisible="context.get('default_project_id')"/>
                <field name="trade_id"/>
                <field name="agency_id" placeholder="Undecided" context="{'default_rvt_is_agency': True}"/>
                <field name="contact_ids" widget="many2many_tags"/>
                <field name="decide_by" invisible="agency_id"/>
                <field name="line_count"/>
                <field name="note" optional="hide"/>
                <field name="is_undecided_late" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="rvt_project_trade_view_search" model="ir.ui.view">
        <field name="name">rvt.project.trade.search</field>
        <field name="model">rvt.project.trade</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="trade_id"/>
                <field name="agency_id"/>
                <filter name="undecided" string="Undecided" domain="[('agency_id', '=', False)]"/>
                <filter name="late" string="Undecided past its date" domain="[('is_undecided_late', '=', True)]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_agency" string="Agency" context="{'group_by': 'agency_id'}"/>
                    <filter name="group_trade" string="Trade" context="{'group_by': 'trade_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="rvt_project_trade_action" model="ir.actions.act_window">
        <field name="name">Trade plans</field>
        <field name="res_model">rvt.project.trade</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>
    <menuitem id="menu_rvt_trade_plans" name="Trade plans" parent="rvt_base.menu_rvt_config"
              action="rvt_project_trade_action" sequence="50"/>
</odoo>
