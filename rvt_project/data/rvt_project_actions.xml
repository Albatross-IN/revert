<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- For administrators, to test a project's set-up without the desk. -->
    <record id="action_rvt_onboard_default" model="ir.actions.server">
        <field name="name">Onboard from the matching preset</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[(4, ref('base.group_system')), (4, ref('rvt_base.group_rvt_owner'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_rvt_onboard_default()</field>
    </record>

    <record id="action_rvt_mark_entity" model="ir.actions.server">
        <field name="name">Use as a room or zone</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[(4, ref('rvt_base.group_rvt_staff'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_rvt_mark_entity()</field>
    </record>
</odoo>
