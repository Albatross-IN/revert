<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="revert_customizations.MomChart">
        <div class="o_mom_chart_canvas" t-attf-style="height: {{ this.props.height or 260 }}px;">
            <canvas t-ref="this.chart.ref"/>
        </div>
    </t>

    <t t-name="revert_customizations.MomDashboard">
        <div class="o_mom_dashboard">

            <div class="o_mom_header">
                <div class="o_mom_header_title" role="button" tabindex="0"
                     title="Back to Projects"
                     t-on-click="() => this.goBack()"
                     t-on-keydown="(ev) => this.onBackKeydown(ev)">
                    <span class="o_mom_eyebrow">MOM Dashboard</span>
                    <h1>
                        <i class="oi o_mom_back_arrow" data-icon="chevron_left"/>
                        <span t-out="this.state.data ? this.state.data.project_name : ''"/>
                    </h1>
                </div>
                <div class="o_mom_header_actions">
                    <button class="btn btn-link o_mom_reset"
                            t-if="this.activeFilterCount"
                            t-on-click="() => this.resetFilters()">
                        Reset filters (<t t-out="this.activeFilterCount"/>)
                    </button>
                    <button class="btn btn-sm o_mom_chip"
                            t-att-disabled="!this.state.data or !this.state.data.entries_total"
                            t-on-click="() => this.printEntries()">
                        <i class="oi me-1" data-icon="picture_as_pdf"/>Print entries
                    </button>
                </div>
            </div>

            <div class="o_mom_filters">
                <div class="o_mom_chips" role="group" aria-label="Status">
                    <t t-foreach="[['all','All'],['open','Open'],['due_later','Due later'],['overdue','Overdue'],['done','Closed']]"
                       t-as="choice" t-key="choice[0]">
                        <button type="button"
                                class="btn btn-sm o_mom_chip"
                                t-att-class="this.state.filters.status === choice[0] ? 'is-active' : ''"
                                t-att-aria-pressed="this.state.filters.status === choice[0] ? 'true' : 'false'"
                                t-on-click="() => this.setStatus(choice[0])">
                            <t t-out="choice[1]"/>
                        </button>
                    </t>
                </div>

                <div class="o_mom_dates">
                    <input type="date" class="form-control form-control-sm"
                           t-att-value="this.state.filters.date_from"
                           t-on-change="(ev) => this.setDate('date_from', ev)"
                           aria-label="From date"/>
                    <span class="o_mom_dash">–</span>
                    <input type="date" class="form-control form-control-sm"
                           t-att-value="this.state.filters.date_to"
                           t-on-change="(ev) => this.setDate('date_to', ev)"
                           aria-label="To date"/>
                </div>

                <t t-foreach="[['partner_ids','partners','Related To'],['user_ids','users','Assignee'],['task_ids','tasks','Task'],['visit_nos','visits','Visit No#']]"
                   t-as="picker" t-key="picker[0]">
                    <div class="o_mom_picker">
                        <button type="button" class="btn btn-sm o_mom_chip"
                                t-att-class="{'is-active': this.state.filters[picker[0]].length, 'is-open': this.state.openPanel === picker[0]}"
                                t-on-click="() => this.togglePanel(picker[0])">
                            <t t-out="this.selectionLabel(picker[0], this.filterOptions[picker[1]], picker[2])"/>
                            <i class="oi ms-1" data-icon="arrow_drop_down"/>
                        </button>
                        <div class="o_mom_picker_panel" t-if="this.state.openPanel === picker[0]">
                            <div class="o_mom_picker_head">
                                <span t-out="picker[2]"/>
                                <button class="btn btn-link btn-sm p-0"
                                        t-if="this.state.filters[picker[0]].length"
                                        t-on-click="() => this.clearSelection(picker[0])">Clear</button>
                            </div>
                            <div class="o_mom_picker_body">
                                <t t-if="!this.filterOptions[picker[1]].length">
                                    <div class="o_mom_muted">Nothing recorded yet.</div>
                                </t>
                                <label t-foreach="this.filterOptions[picker[1]]" t-as="option" t-key="option.id"
                                       class="o_mom_option">
                                    <input type="checkbox"
                                           t-att-checked="this.isSelected(picker[0], option.id)"
                                           t-on-change="() => this.toggleSelection(picker[0], option.id)"/>
                                    <span class="o_mom_option_name" t-out="option.name"/>
                                    <span class="o_mom_option_count" t-out="option.count"/>
                                </label>
                            </div>
                        </div>
                    </div>
                </t>

                <label class="o_mom_check">
                    <input type="checkbox"
                           t-att-checked="this.state.filters.with_photo"
                           t-on-change="() => this.toggleWithPhoto()"/>
                    <span>With photo</span>
                </label>
            </div>

            <div class="o_mom_body">
                <t t-if="this.state.error">
                    <div class="alert alert-danger" t-out="this.state.error"/>
                </t>

                <t t-elif="this.state.loading and !this.state.data">
                    <div class="o_mom_placeholder">Loading MOM entries…</div>
                </t>

                <t t-elif="this.state.data">
                    <!-- Each tile is the filter it counts: pressed while
                         that filter is on, and a click toggles it. -->
                    <div class="o_mom_kpis" t-att-class="this.state.loading ? 'o_mom_busy' : ''">
                        <button type="button"
                                t-foreach="this.kpiTiles" t-as="tile" t-key="tile.key"
                                class="o_mom_kpi"
                                t-att-class="{
                                    'is-active': this.kpiActive(tile.key),
                                    'o_mom_kpi_alert': tile.key === 'overdue',
                                    'is-hot': tile.key === 'overdue' and this.state.data.kpis.overdue,
                                }"
                                t-att-aria-pressed="this.kpiActive(tile.key) ? 'true' : 'false'"
                                t-att-title="tile.hint"
                                t-on-click="() => this.onKpiClick(tile.key)">
                            <span class="o_mom_kpi_value" t-out="this.state.data.kpis[tile.key]"/>
                            <span class="o_mom_kpi_label" t-out="tile.label"/>
                        </button>
                    </div>

                    <t t-if="!this.state.data.kpis.total">
                        <div class="o_mom_placeholder">
                            No MOM entries match these filters.
                        </div>
                    </t>

                    <t t-else="">
                        <div class="o_mom_charts">
                            <section class="o_mom_card">
                                <h2>Status split <small class="o_mom_hint">click a segment to filter</small></h2>
                                <MomChart type="'doughnut'"
                                          chartData="this.statusChartData"
                                          options="this.statusChartOptions"
                                          onSelect.bind="this.onStatusSelect"
                                          height="240"/>
                            </section>
                            <section class="o_mom_card">
                                <h2>Top Related To <small class="o_mom_hint">click a bar to filter</small></h2>
                                <t t-if="this.state.data.by_partner.length">
                                    <MomChart type="'bar'"
                                              chartData="this.partnerChartData"
                                              options="this.partnerChartOptions"
                                              onSelect.bind="this.onPartnerSelect"
                                              height="240"/>
                                </t>
                                <t t-else="">
                                    <div class="o_mom_muted">No contact recorded on these entries.</div>
                                </t>
                            </section>
                        </div>

                        <section class="o_mom_card" t-if="this.state.data.by_period.length">
                            <h2>Entries by month <small class="o_mom_hint">click a bar to filter</small></h2>
                            <MomChart type="'bar'"
                                      chartData="this.periodChartData"
                                      options="this.periodChartOptions"
                                      onSelect.bind="this.onPeriodSelect"
                                      height="240"/>
                        </section>

                        <section class="o_mom_card o_mom_table_card">
                            <div class="o_mom_table_head">
                                <h2>Entries</h2>
                                <div class="o_mom_pager">
                                    <span t-out="this.pageStart"/>–<span t-out="this.pageEnd"/>
                                    <span class="o_mom_muted"> of </span>
                                    <span t-out="this.state.data.entries_total"/>
                                    <button class="btn btn-sm o_mom_icon_btn" t-att-disabled="!this.hasPrevious"
                                            aria-label="Previous page"
                                            t-on-click="() => this.goToPage(-1)">
                                        <i class="oi" data-icon="chevron_left"/>
                                    </button>
                                    <button class="btn btn-sm o_mom_icon_btn" t-att-disabled="!this.hasNext"
                                            aria-label="Next page"
                                            t-on-click="() => this.goToPage(1)">
                                        <i class="oi" data-icon="chevron_right"/>
                                    </button>
                                </div>
                            </div>
                            <div class="o_mom_table_scroll">
                                <table class="table table-sm o_mom_table">
                                    <thead>
                                        <tr>
                                            <th class="o_mom_num">Sr.</th>
                                            <th class="o_mom_num">Visit</th>
                                            <th>Task</th>
                                            <th>Remark</th>
                                            <th>Related To</th>
                                            <th>Assigned to</th>
                                            <th>Created</th>
                                            <th>End Date</th>
                                            <th>Photo</th>
                                            <th>Status</th>
                                            <th class="o_mom_actions_head">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="this.state.data.entries" t-as="entry" t-key="entry.id"
                                            class="o_mom_row"
                                            t-on-click="() => this.openTask(entry.task_id)">
                                            <td class="o_mom_num" t-out="entry.sequence"/>
                                            <td class="o_mom_num" t-out="entry.visit_no"/>
                                            <td t-out="entry.task_name"/>
                                            <td class="o_mom_remark" t-out="entry.summary"/>
                                            <td t-out="entry.partner_name"/>
                                            <td t-out="entry.user_name"/>
                                            <td class="o_mom_num" t-att-title="entry.created_full"
                                                t-out="entry.created"/>
                                            <td class="o_mom_num" t-out="entry.date_deadline"/>
                                            <td>
                                                <img t-if="entry.has_photo" class="o_mom_thumb"
                                                     t-att-src="this.photoUrl(entry.id)" alt="Site photo"
                                                     t-on-mouseenter="(ev) => this.showPreview(entry, ev)"
                                                     t-on-mouseleave="() => this.hidePreview()"/>
                                            </td>
                                            <td>
                                                <span class="o_mom_badge" t-att-class="'is-' + entry.status"
                                                      t-out="entry.status"/>
                                            </td>
                                            <!-- Both buttons stop the click reaching
                                                 the row, which opens the task. -->
                                            <td class="o_mom_actions">
                                                <button class="btn btn-sm o_mom_action"
                                                        title="Edit this entry"
                                                        aria-label="Edit this entry"
                                                        t-on-click="(ev) => this.editEntry(entry, ev)">
                                                    <i class="oi" data-icon="edit"/>
                                                </button>
                                                <button class="btn btn-sm o_mom_action o_mom_action_done"
                                                        t-if="entry.status !== 'done'"
                                                        title="Mark done with a closing note"
                                                        aria-label="Mark done"
                                                        t-on-click="(ev) => this.markDone(entry, ev)">
                                                    <i class="oi" data-icon="check"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </t>
                </t>
            </div>

            <div class="o_mom_preview" t-if="this.state.preview"
                 t-attf-style="top: {{ this.state.preview.top }}px; left: {{ this.state.preview.left }}px; max-width: {{ this.state.preview.size }}px;">
                <img t-att-src="this.state.preview.url" alt="Site photo"/>
                <div class="o_mom_preview_caption" t-if="this.state.preview.summary"
                     t-out="this.state.preview.summary"/>
            </div>
        </div>
    </t>

    <t t-name="revert_customizations.MomDoneDialog">
        <Dialog title="'Mark MOM entry done'" size="'md'">
            <div class="o_mom_done_dialog">
                <p class="o_mom_done_summary" t-out="this.props.entry.summary"/>
                <label class="form-label" for="mom_done_feedback">Closing note</label>
                <textarea id="mom_done_feedback" class="form-control" rows="4"
                          t-ref="this.textareaRef"
                          t-model.proxy="this.state.feedback"
                          placeholder="What was done to close this point?"/>
                <p class="o_mom_done_hint">
                    The note is posted to the task's chatter. The entry stays in
                    the MOM report, marked Closed.
                </p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="this.state.busy"
                        t-on-click="() => this.confirm()">
                    Mark done
                </button>
                <button class="btn btn-secondary" t-att-disabled="this.state.busy"
                        t-on-click="() => this.props.close()">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

</templates>
