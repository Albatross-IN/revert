<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirement C: reach the MOM dashboard from the project's kanban card,
         alongside the standard Reporting entries. The card content lives in
         its own card view since 20 (the kanban only points at it). -->
    <record id="view_project_card_inherit_mom" model="ir.ui.view">
        <field name="name">project.project.card.mom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_card"/>
        <field name="arch" type="xml">
            <!-- Visible entry on the card itself, right under the Tasks count.
                 The card's kebab menu only appears on hover, so a dropdown
                 entry alone is too easy to miss. An <a>: in a card only links
                 and buttons with name/type are compiled into actions (the
                 Tasks row above is a plain div; the whole card opens tasks). -->
            <xpath expr="//div[@name='action_view_tasks']" position="after">
                <a class="d-flex gap-2 align-items-baseline text-muted text-truncate"
                   role="button"
                   name="action_open_mom_dashboard"
                   type="object"
                   groups="project.group_project_user"
                   title="Open the MOM dashboard for this project">
                    <i class="oi oi-filled" data-icon="assignment" title="MOM"/>
                    <span>
                        <field name="mom_activity_count" class="o_value"/> MOM
                    </span>
                </a>
            </xpath>
            <xpath expr="//div[@name='project_burndown_menu']" position="after">
                <div class="d-inline-block w-100" role="menuitem" name="mom_dashboard_menu" groups="project.group_project_user">
                    <a name="action_open_mom_dashboard" type="object">MOM Dashboard</a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="edit_project_inherit_mom" model="ir.ui.view">
        <field name="name">project.project.form.mom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_mom_dashboard"
                        icon="assignment"
                        groups="project.group_project_user"
                        invisible="not mom_activity_count">
                    <field name="mom_activity_count" widget="statinfo" string="MOM Entries"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
