<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='description_page']" position="after">
                <page name="mom_meetings_page" string="MOM Meetings">
                    <field name="agenda" placeholder="Write opening agenda here..."/>
                    <field name="person_ids">
                        <list editable="bottom">
                            <field name="seq" readonly="1"/>
                            <field name="from_client"/>
                            <field name="from_architect"/>
                            <field name="from_agency"/>
                        </list>
                    </field>
                    <field name="mom_meeting_ids">
                        <list editable="bottom">
                            <field name="seq" readonly="1"/>
                            <field name="remarks"/>
                            <field name="related_to"/>
                            <field name="end_date"/>
                            <field name="site_photo" widget="image" options="{'size': [64, 64]}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Custom Tree View for Tasks and Sub-Tasks -->
    <record id="view_task_subtask_tree" model="ir.ui.view">
        <field name="name">project.task.subtask.tree</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Tasks and Sub-Tasks" multi_edit="1" sample="1">
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="parent_id" optional="show"/>
                <field name="planned_date_begin" optional="show" string="Start Date"/>
                <field name="date_deadline" optional="show" string="Deadline / End Date"/>
                <field name="stage_id" optional="show"/>
                <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="state" widget="project_task_state_selection" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Custom Window Action for All Tasks and Sub-Tasks -->
    <record id="action_view_all_tasks_subtasks" model="ir.actions.act_window">
        <field name="name">All Tasks &amp; Sub-Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,gantt,kanban,form</field>
        <field name="domain">[]</field>
        <field name="context">{'group_by': ['project_id', 'parent_id']}</field>
        <field name="view_id" ref="view_task_subtask_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks found. Let's create one!
            </p>
            <p>
                Keep track of all your tasks and sub-tasks across projects in one place.
            </p>
        </field>
    </record>

    <!-- Dedicated Menu Item -->
    <menuitem id="menu_all_tasks_subtasks" 
              name="All Tasks &amp; Sub-Tasks" 
              parent="project.menu_main_pm" 
              action="action_view_all_tasks_subtasks" 
              sequence="6"/>

</odoo>