<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FR-04: the MOM fields show only when the selected activity type is
         flagged as a MOM type. The rule reads the type's own flag, so another
         MOM-like type can be added later without touching this view.
         mail.mail_activity_view_form is a primary view built on this popup,
         so extending the popup covers the full activity form as well.
         The popup lays its fields out as icon rows inside activity_details;
         the MOM rows follow the Summary row and the photo precedes the Note
         row, in the same style. -->
    <record id="mail_activity_view_form_popup_mom" model="ir.ui.view">
        <field name="name">mail.activity.view.form.popup.mom</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='activity_details']/div[.//field[@name='summary']]" position="after">
                <field name="is_mom" invisible="1"/>
                <div class="o_outlined d-flex align-items-center mb-2 gap-2" name="mom_partner_row" invisible="not is_mom">
                    <i class="oi oi-filled mb-2" data-icon="handshake" title="Related To"/>
                    <field name="mom_partner_id" nolabel="1" class="w-100" placeholder="Related To"
                           required="is_mom"
                           options="{'no_create_edit': True}"/>
                </div>
                <div class="o_outlined d-flex align-items-baseline mb-2 gap-2" name="mom_visit_date_row" invisible="not is_mom">
                    <i class="oi oi-filled" data-icon="location_on" title="Visit Date"/>
                    <span class="text-muted text-nowrap">Visit Date</span>
                    <field name="mom_visit_date" nolabel="1" class="w-100" required="is_mom"/>
                </div>
                <div class="o_outlined d-flex align-items-baseline mb-2 gap-2" name="mom_visit_row" invisible="not is_mom">
                    <i class="oi" data-icon="tag" title="Visit No#"/>
                    <span class="text-muted text-nowrap">Visit No#</span>
                    <field name="mom_visit_no" nolabel="1" class="w-100"/>
                </div>
                <div class="o_outlined d-flex align-items-baseline mb-2 gap-2" name="mom_sequence_row"
                     invisible="not is_mom or not mom_sequence">
                    <i class="oi" data-icon="format_list_numbered" title="Sequence"/>
                    <span class="text-muted text-nowrap">Sr. No.</span>
                    <field name="mom_sequence" nolabel="1" class="w-100" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='activity_details']/div[.//field[@name='note']]" position="before">
                <div class="o_outlined d-flex align-items-start mb-2 gap-2" name="mom_photo_row" invisible="not is_mom">
                    <i class="oi oi-filled pt-1" data-icon="photo_camera" title="Site Photo"/>
                    <field name="mom_site_photo"
                           widget="image"
                           class="oe_avatar"
                           options="{'size': [0, 200]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- FR-07: the form behind a row of the MOM Entries list on the task.
         Only the remark and the visit date are editable there; the rest of an
         entry stays owned by the Activities widget in the chatter, which is
         where entries are created and closed. Primary, so it applies only where project.task
         asks for it by form_view_ref and never replaces the generic activity
         popup. The core footer goes: inside a one2many the edit is held on the
         task until the task itself is saved, so the activity's own Schedule /
         Save / Mark as Done buttons would act on the database record behind
         the edit. Dropping them leaves the dialog's Save & Close and Discard,
         which write through the task. -->
    <record id="mail_activity_view_form_mom_entry" model="ir.ui.view">
        <field name="name">mail.activity.view.form.mom.entry</field>
        <field name="model">mail.activity</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <field name="activity_type_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="date_deadline" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="user_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="role_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="note" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="mom_partner_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="mom_site_photo" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <footer position="replace"/>
        </field>
    </record>

    <record id="mail_activity_type_view_form_mom" model="ir.ui.view">
        <field name="name">mail.activity.type.view.form.mom</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="mail.mail_activity_type_view_form"/>
        <field name="arch" type="xml">
            <field name="category" position="after">
                <field name="is_mom"/>
            </field>
        </field>
    </record>

    <!-- FR-04: the chatter's "Schedule Activity" dialog is the
         mail.activity.schedule wizard, so the MOM fields have to be added
         here as well as on the activity form itself. Same icon-row layout as
         the wizard's own fields. -->
    <record id="mail_activity_schedule_view_form_mom" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.mom</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_activity_details')]/div[.//field[@name='summary']]" position="after">
                <field name="is_mom" invisible="1"/>
                <div class="o_outlined d-flex align-items-center mb-2 gap-2" name="mom_partner_row" invisible="not is_mom">
                    <i class="oi oi-filled mb-2" data-icon="handshake" title="Related To"/>
                    <field name="mom_partner_id" nolabel="1" class="w-100" placeholder="Related To"
                           required="is_mom and not plan_id"
                           options="{'no_create_edit': True}"/>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_activity_details')]/div[.//field[@name='activity_user_id']]" position="after">
                <div class="o_outlined d-flex align-items-baseline mb-2 gap-2" name="mom_visit_date_row" invisible="not is_mom">
                    <i class="oi oi-filled" data-icon="location_on" title="Visit Date"/>
                    <span class="text-muted text-nowrap">Visit Date</span>
                    <field name="mom_visit_date" nolabel="1" class="w-100" required="is_mom"/>
                </div>
                <div class="o_outlined d-flex align-items-baseline mb-2 gap-2" name="mom_sequence_row"
                     invisible="not is_mom or not mom_sequence">
                    <i class="oi" data-icon="format_list_numbered" title="Sequence"/>
                    <span class="text-muted text-nowrap">Sr. No.</span>
                    <field name="mom_sequence" nolabel="1" class="w-100" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_activity_details')]/div[.//field[@name='note']]" position="before">
                <div class="o_outlined d-flex align-items-start mb-2 gap-2" name="mom_photo_row" invisible="not is_mom">
                    <i class="oi oi-filled pt-1" data-icon="photo_camera" title="Site Photo"/>
                    <field name="mom_site_photo"
                           widget="image"
                           class="oe_avatar"
                           options="{'size': [0, 200]}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
