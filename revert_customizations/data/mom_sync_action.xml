<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Requirement B, bulk path: the same sync run over a selection of
             tasks from the list view's Actions menu. -->
        <record id="action_sync_mom_activities_server" model="ir.actions.server">
            <field name="name">Sync MOM Activities</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="binding_model_id" ref="project.model_project_task"/>
            <field name="binding_view_types">list</field>
            <field name="groups_id" eval="[(4, ref('project.group_project_manager'))]"/>
            <field name="state">code</field>
            <field name="code">action = records.action_sync_mom_activities()</field>
        </record>
    </data>
</odoo>
