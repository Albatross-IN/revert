<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plain views for administrators. Staff work in the desk. -->
    <record id="rvt_point_view_list" model="ir.ui.view">
        <field name="name">rvt.point.list</field>
        <field name="model">rvt.point</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'" decoration-danger="state == 'open' and due_date and due_date &lt; context_today().strftime('%Y-%m-%d')">
                <field name="project_id"/>
                <field name="visit_id" optional="show"/>
                <field name="number"/>
                <field name="text"/>
                <field name="for_kind"/>
                <field name="party_label"/>
                <field name="entity_id" optional="show"/>
                <field name="trade_id" optional="hide"/>
                <field name="due_date"/>
                <field name="has_photo" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-warning="state == 'open'"/>
                <field name="legacy_activity_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="rvt_point_view_form" model="ir.ui.view">
        <field name="name">rvt.point.form</field>
        <field name="model">rvt.point</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="visit_id"/>
                            <field name="number"/>
                            <field name="for_kind"/>
                            <field name="partner_id" invisible="for_kind == 'staff'"/>
                            <field name="person_id" invisible="for_kind != 'agency'"/>
                            <field name="user_id" invisible="for_kind != 'staff'"/>
                            <field name="party_name" invisible="for_kind != 'vendor'"/>
                            <field name="client_confirmed" invisible="for_kind != 'client'"/>
                        </group>
                        <group>
                            <field name="entity_id"/>
                            <field name="trade_id"/>
                            <field name="drawing_id"/>
                            <field name="due_date"/>
                            <field name="raised_by_id"/>
                            <field name="raised_on"/>
                            <field name="sent_count"/>
                        </group>
                    </group>
                    <group string="Point"><field name="text" nolabel="1" colspan="2"/></group>
                    <group>
                        <group string="Photo"><field name="photo" widget="image" nolabel="1" colspan="2" options="{'size': [0, 220]}"/></group>
                        <group string="Closing" invisible="state != 'closed'">
                            <field name="closed_by_id"/>
                            <field name="closed_on"/>
                            <field name="close_note"/>
                            <field name="close_photo" widget="image" options="{'size': [0, 160]}"/>
                        </group>
                    </group>
                    <group string="Moved from the earlier MOM" invisible="not legacy_activity_id">
                        <field name="legacy_activity_id"/>
                        <field name="legacy_task_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="rvt_point_view_search" model="ir.ui.view">
        <field name="name">rvt.point.search</field>
        <field name="model">rvt.point</field>
        <field name="arch" type="xml">
            <search>
                <field name="text"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="entity_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="late" string="Past their date" domain="[('state', '=', 'open'), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="unconfirmed" string="Client points to confirm" domain="[('for_kind', '=', 'client'), ('client_confirmed', '=', False), ('state', '=', 'open')]"/>
                <filter name="moved" string="Moved from the earlier MOM" domain="[('legacy_activity_id', '>', 0)]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_visit" string="Visit" context="{'group_by': 'visit_id'}"/>
                    <filter name="group_party" string="Party" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_kind" string="For" context="{'group_by': 'for_kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="rvt_point_action" model="ir.actions.act_window">
        <field name="name">Points</field>
        <field name="res_model">rvt.point</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="rvt_visit_view_list" model="ir.ui.view">
        <field name="name">rvt.visit.list</field>
        <field name="model">rvt.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="number"/>
                <field name="date"/>
                <field name="started_by_id"/>
                <field name="attendees"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="rvt_visit_view_form" model="ir.ui.view">
        <field name="name">rvt.visit.form</field>
        <field name="model">rvt.visit</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <group><field name="project_id"/><field name="date"/><field name="number"/></group>
                        <group><field name="started_by_id"/><field name="attendees"/></group>
                    </group>
                    <field name="point_ids" readonly="1">
                        <list>
                            <field name="number"/><field name="text"/><field name="party_label"/><field name="entity_id"/><field name="due_date"/><field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="rvt_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">rvt.visit</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rvt_points" name="Points" parent="rvt_base.menu_rvt_config" action="rvt_point_action" sequence="62"/>
    <menuitem id="menu_rvt_visits" name="Visits" parent="rvt_base.menu_rvt_config" action="rvt_visit_action" sequence="64"/>
</odoo>
