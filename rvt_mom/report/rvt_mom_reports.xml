<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_mom" model="report.paperformat">
        <field name="name">Revert MOM (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- One layout for the three PDFs: the whole visit, one party's points, the open points of a project. -->
    <template id="mom_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="sheet">
                <t t-call="web.basic_layout">
                    <style>
                        .rvm { font-family: "Plus Jakarta Sans", "Noto Sans Gujarati", "Noto Sans Devanagari", Arial, sans-serif; color: #182033; font-size: 12px; }
                        .rvm-h { border-bottom: 2px solid #C4861C; padding-bottom: 10px; margin-bottom: 12px; }
                        .rvm table, .rvm td, .rvm th { border: 0 none; }
                        .rvm-h table { width: 100%; }
                        .rvm-h img { max-height: 46px; max-width: 190px; }
                        .rvm-h .t { text-align: right; }
                        .rvm-h .t b { display: block; font-size: 19px; letter-spacing: -.01em; }
                        .rvm-h .t span { color: #6B7285; font-size: 11px; }
                        .rvm-m { width: 100%; margin-bottom: 14px; border-collapse: separate; border-spacing: 6px 0; }
                        .rvm-m td { background: #F4F1EA; border-radius: 8px; padding: 7px 10px; width: 25%; vertical-align: top; }
                        .rvm-m span { display: block; color: #6B7285; font-size: 9.5px; text-transform: uppercase; letter-spacing: .08em; }
                        .rvm-m b { font-size: 12px; }
                        table.rvm-t { width: 100%; border-collapse: collapse; }
                        table.rvm-t th { text-align: left; font-size: 9.5px; text-transform: uppercase; letter-spacing: .08em; color: #6B7285; border-bottom: 1px solid #182033 !important; padding: 6px 8px; }
                        table.rvm-t td { border-bottom: 1px solid #E3DFD5 !important; padding: 8px; vertical-align: top; page-break-inside: avoid; }
                        table.rvm-t td.n { font-family: "JetBrains Mono", monospace; width: 34px; }
                        table.rvm-t td.d { font-family: "JetBrains Mono", monospace; width: 62px; white-space: nowrap; }
                        table.rvm-t td.d.late { color: #DC3535; font-weight: 700; }
                        .rvm-new { background: #E2A534; color: #3A2500; font-size: 9px; font-weight: 800; border-radius: 4px; padding: 1px 5px; margin-left: 5px; }
                        .rvm-closed { color: #0E9453; font-style: italic; }
                        .rvm-change { display: block; margin-top: 3px; color: #DC3535; font-weight: 700; }
                        .rvm-check { color: #9A6B00; font-style: italic; }
                        .rvm-ph { display: block; margin-top: 6px; max-height: 190px; max-width: 260px; border-radius: 6px; }
                        table.rvm-ba { margin-top: 6px; border-collapse: separate; border-spacing: 0; }
                        table.rvm-ba td { border: 0 none !important; padding: 0 8px 0 0 !important; }
                        table.rvm-ba span { display: block; color: #6B7285; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }
                        table.rvm-ba img { display: block; margin-top: 3px; max-height: 170px; max-width: 200px; border-radius: 6px; }
                        table.rvm-t td.v { font-family: "JetBrains Mono", monospace; width: 40px; white-space: nowrap; color: #6B7285; }
                        .rvm-f { margin-top: 18px; color: #6B7285; font-size: 10px; text-align: center; }
                    </style>
                    <div class="page rvm">
                        <div class="rvm-h">
                            <table><tr>
                                <td><img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/><b t-else="" t-out="company.name"/></td>
                                <td class="t"><b t-out="sheet['title']"/><span><t t-out="company.name"/><t t-if="place"> · <t t-out="place"/></t></span></td>
                            </tr></table>
                        </div>
                        <table class="rvm-m"><tr>
                            <td t-foreach="sheet['meta']" t-as="m"><span t-out="m[0]"/><b t-out="m[1]"/></td>
                        </tr></table>
                        <table class="rvm-t">
                            <thead><tr><th>No</th><th t-if="sheet.get('show_visit')">Visit</th><th>Point</th><th>For</th><th>Area</th><th>By</th></tr></thead>
                            <tbody>
                                <tr t-foreach="sheet['rows']" t-as="row">
                                    <td class="n" t-out="row['number']"/>
                                    <td t-if="sheet.get('show_visit')" class="v"><t t-if="row['visit']">V<t t-out="row['visit']"/></t><t t-else="">office</t></td>
                                    <td>
                                        <span t-out="row['text']" style="white-space: pre-line"/><span t-if="row['new']" class="rvm-new">NEW</span>
                                        <span t-if="row['closed']" class="rvm-closed"> (closed<t t-if="row['close_note']">: <t t-out="row['close_note']"/></t>)</span>
                                        <span t-if="row.get('to_check')" class="rvm-check"> (marked done, to be checked)</span>
                                        <span t-if="row.get('change')" class="rvm-change">Change asked: <t t-out="row['change']"/></span>
                                        <table t-if="row['after']" class="rvm-ba"><tr>
                                            <td t-if="row['photo']"><span>Before</span><img t-att-src="row['photo']" alt="Before"/></td>
                                            <td><span>After</span><img t-att-src="row['after']" alt="After"/></td>
                                        </tr></table>
                                        <img t-elif="row['photo']" class="rvm-ph" t-att-src="row['photo']" alt="Photo"/>
                                    </td>
                                    <td t-out="row['party']"/>
                                    <td t-out="row['area']"/>
                                    <td t-attf-class="d #{'late' if row['late'] else ''}" t-out="row['due']"/>
                                </tr>
                                <tr t-if="not sheet['rows']"><td colspan="6">No points.</td></tr>
                            </tbody>
                        </table>
                        <div class="rvm-f">A point agreed on site is a MOM point in the app.</div>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="report_visit"><t t-call="rvt_mom.mom_document"/></template>
    <template id="report_open_points"><t t-call="rvt_mom.mom_document"/></template>
    <template id="report_points"><t t-call="rvt_mom.mom_document"/></template>

    <record id="action_report_visit" model="ir.actions.report">
        <field name="name">MOM</field>
        <field name="model">rvt.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rvt_mom.report_visit</field>
        <field name="print_report_name">'MOM - %s - visit %s' % (object.project_id.name, object.number)</field>
        <field name="paperformat_id" ref="paperformat_mom"/>
        <field name="binding_model_id" ref="model_rvt_visit"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_points" model="ir.actions.report">
        <field name="name">Points</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rvt_mom.report_points</field>
        <field name="print_report_name">'Points - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_mom"/>
    </record>
    <record id="action_report_open_points" model="ir.actions.report">
        <field name="name">Open points</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rvt_mom.report_open_points</field>
        <field name="print_report_name">'Open points - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_mom"/>
    </record>
</odoo>
